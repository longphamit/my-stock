# Git
.git
.github
.gitignore

# Python Cache & Virtual Environments
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ipynb_checkpoints/
venv/
.venv/
env/

# IDE files
.idea/
.vscode/
*.swp
*.swo

# Docker files
Dockerfile
.dockerignore

